{
  "name": "kids-house-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && bash deploy.sh",
    "server": "tsx server/node.ts",
    "worker:dev": "npx -y node@22 node_modules/wrangler/bin/wrangler.js dev --local --port 8788 --var ALLOWED_ORIGIN:*",
    "worker:login": "npx -y node@22 node_modules/wrangler/bin/wrangler.js login",
    "worker:deploy": "npx -y node@22 node_modules/wrangler/bin/wrangler.js deploy",
    "test:hood": "/workspace/.pwvenv/bin/python hood_test.py",
    "test:pets": "/workspace/.pwvenv/bin/python pets_test.py",
    "test:eggs": "/workspace/.pwvenv/bin/python eggs_test.py",
    "test:ranch": "/workspace/.pwvenv/bin/python ranch_test.py",
    "test:ride": "/workspace/.pwvenv/bin/python ride_pose_test.py",
    "test:whatsnew": "/workspace/.pwvenv/bin/python whatsnew_test.py"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "wrangler": "^4.151.1",
    "ws": "^8.22.0"
  }
}
